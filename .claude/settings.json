{
  "permissions": {
    "allow": [
      "Bash(uv sync:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run python:*)",
      "Bash(uv run streamlit:*)",
      "Bash(uv pip list:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Edit(data/raw/**)",
      "Write(data/raw/**)",
      "Edit(reference/**)",
      "Write(reference/**)",
      "Bash(git push:*)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  }
}
